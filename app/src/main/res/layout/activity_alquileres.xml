<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity_Alquileres">

    <ImageView
        android:id="@+id/imgFondoAlquileres"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/fondo3" />

    <TextView
        android:id="@+id/txtvSeleccionarMaquina"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:text="Seleccionar Maquinaria:"
        android:textColor="#000000"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Spinner
        android:id="@+id/spnMaquinas"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:minHeight="48dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/txtvSeleccionarMaquina"
        app:layout_constraintTop_toBottomOf="@+id/txtvSeleccionarMaquina" />

    <TextView
        android:id="@+id/txtvSeleccionarCliente"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Seleccionar Cliente:"
        android:textColor="#000000"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/spnMaquinas"
        app:layout_constraintTop_toBottomOf="@+id/spnMaquinas" />

    <Spinner
        android:id="@+id/spnClientes"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:minHeight="48dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/txtvSeleccionarCliente"
        app:layout_constraintTop_toBottomOf="@+id/txtvSeleccionarCliente" />

    <TextView
        android:id="@+id/txtvDiasAlquiler"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Días de alquiler:"
        android:textColor="#000000"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/spnClientes"
        app:layout_constraintTop_toBottomOf="@+id/spnClientes" />

    <EditText
        android:id="@+id/txtDiasAlquiler"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:ems="10"
        android:hint="Ingrese cantidad de días"
        android:inputType="number"
        android:textColor="#000000"
        android:textColorHint="#444444"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/txtvDiasAlquiler"
        app:layout_constraintTop_toBottomOf="@+id/txtvDiasAlquiler" />

    <Button
        android:id="@+id/btnCalcularTotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:backgroundTint="#1B0202"
        android:text="Calcular Total"
        app:layout_constraintStart_toStartOf="@+id/txtDiasAlquiler"
        app:layout_constraintTop_toBottomOf="@+id/txtDiasAlquiler" />

    <TextView
        android:id="@+id/txtvTotalCalculadoLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Precio Total:"
        android:textColor="#8E8D8D"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/btnCalcularTotal"
        app:layout_constraintTop_toBottomOf="@+id/btnCalcularTotal" />

    <TextView
        android:id="@+id/txtTotalCalculado"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:text="Total a Pagar: $0"
        android:textColor="#8E8D8D"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/txtvTotalCalculadoLabel"
        app:layout_constraintTop_toBottomOf="@+id/txtvTotalCalculadoLabel" />

    <Button
        android:id="@+id/btnGuardarAlquiler"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="#1B0202"
        android:text="Guardar"
        app:layout_constraintStart_toStartOf="@+id/txtTotalCalculado"
        app:layout_constraintTop_toBottomOf="@+id/txtTotalCalculado" />

    <Button
        android:id="@+id/btnEliminarAlquiler"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:backgroundTint="#1B0202"
        android:text="Eliminar"
        app:layout_constraintStart_toEndOf="@+id/btnGuardarAlquiler"
        app:layout_constraintTop_toTopOf="@+id/btnGuardarAlquiler" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewAlquileres"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@+id/btnVolverAlquiler"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/btnGuardarAlquiler"
        app:layout_constraintTop_toBottomOf="@+id/btnGuardarAlquiler" />

    <Button
        android:id="@+id/btnVolverAlquiler"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#1B0202"
        android:text="Volver"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
